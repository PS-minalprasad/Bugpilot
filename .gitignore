# =============================================================================
# BugPilot — .gitignore
# =============================================================================

# ----- Environment & Secrets (NEVER commit) ----------------------------------
.env
.env.local
.env.*.local
*.secret
secrets/

# ----- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
lib/
lib64/
.installed.cfg
MANIFEST

# Virtual environments
.venv/
venv/
ENV/
env/
.python-version

# Pytest & coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.coveragerc

# MyPy
.mypy_cache/
.dmypy.json
dmypy.json

# Ruff / linting
.ruff_cache/

# ----- Node / Frontend -------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
frontend/dist/
frontend/build/
frontend/.vite/

# ----- IDE & Editor ----------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ----- Logs ------------------------------------------------------------------
logs/
*.log
log/

# ----- Data (generated, not committed) ---------------------------------------
data/generated/
data/exports/

# ----- Docs (generated) ------------------------------------------------------
docs/_build/
docs/site/

# Local databases
*.db
*.sqlite
*.sqlite3
