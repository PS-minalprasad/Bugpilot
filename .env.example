# =============================================================================
# BugPilot — Environment Variables Example
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# ---- Application -------------------------------------------------------------
APP_NAME=BugPilot
APP_DESCRIPTION="AI-Powered Engineering Bug Intelligence Agent"
APP_VERSION=1.0.0
ENV=development
DEBUG=true
HOST=127.0.0.1
PORT=8000
API_PREFIX=/api
LOG_LEVEL=INFO

# ---- Database & Authentication ----------------------------------------------
DATABASE_URL=sqlite:///./bugpilot.db
JWT_SECRET_KEY=change-this-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---- Data Provider -----------------------------------------------------------
# Options: sql | postgres | synthetic
PROVIDER_MODE=sql
DATA_LABEL=SQLite

# ---- LLM Configuration -------------------------------------------------------
# Primary: Groq API | Fallback: Local Ollama
LLM_PROVIDER=groq

# Groq (Primary Provider)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama (Automatic Fallback Provider)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b