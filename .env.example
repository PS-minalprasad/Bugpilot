# =============================================================================
# BugPilot — Environment Variables Example
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# ---- REQUIRED FOR LOCAL RUN --------------------------------------------------
APP_NAME=BugPilot
APP_DESCRIPTION="AI-Powered Engineering Bug Intelligence Agent"
APP_VERSION=1.0.0
ENV=development
DEBUG=true
HOST=127.0.0.1
PORT=8000
API_PREFIX=/api
LOG_LEVEL=INFO

# ---- Database & Authentication (Required) -----------------------------------
DATABASE_URL=sqlite:///./bugpilot.db
JWT_SECRET_KEY=bugpilot-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---- Data Provider Configuration ---------------------------------------------
PROVIDER_MODE=postgres # Options: "postgres" (default) | "synthetic"
DATA_LABEL="PostgreSQL"

# ---- OPTIONAL: LLM Provider Configuration -----------------------------------
LLM_PROVIDER=gemini # Local fallback active if GEMINI_API_KEY is omitted
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash
